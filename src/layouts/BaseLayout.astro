---
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts'

import BaseHead from '@/components/BaseHead.astro'
import { ClientRouter } from 'astro:transitions'

interface Props {
  title?: string
  description?: string
  image?: string | ImageMetadata
  pubDate?: string
  children: unknown
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION, image, pubDate } = Astro.props
---

<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <BaseHead {title} {description} {image} {pubDate} />
    <ClientRouter />
  </head>
  <body class="site-layout">
    <a class="skip-link button button-primary" href="#main-content">跳到主要内容</a>
    <script>
      import { theme, type ThemeType } from '@/lib/store/theme'

      function updateTheme(selected: ThemeType) {
        if (!document.body.classList.contains('site-layout')) return
        document.documentElement.dataset.theme = selected.colorMode
        const canvas = getComputedStyle(document.documentElement).getPropertyValue('--color-canvas').trim()
        if (canvas) document.querySelector('meta[name="theme-color"]')?.setAttribute('content', canvas)
      }

      const unsubscribe = theme.subscribe(updateTheme)
      const afterSwap = () => updateTheme(theme.get())
      document.addEventListener('astro:after-swap', afterSwap)

      if (import.meta.hot) {
        import.meta.hot.accept()
        import.meta.hot.dispose(() => {
          unsubscribe()
          document.removeEventListener('astro:after-swap', afterSwap)
        })
      }
    </script>
    <script>
      if (import.meta.env.DEV) {
        const VConsole = (await import('vconsole')).default
        let instance = new VConsole()

        document.addEventListener('astro:after-swap', () => {
          instance.destroy()
          instance = new VConsole()
        })
      }
    </script>
    <slot name="header" />
    <div class="site-body">
      <slot name="body" />
    </div>
    <slot name="footer" />
  </body>
</html>

<style>
  @reference '../styles/global.css';

  .site-layout { display: flex; min-height: 100dvh; flex-direction: column; }
  .site-body { display: flex; min-height: 50vh; flex: 1; flex-direction: column; }
  .skip-link { position: fixed; top: 12px; left: 20px; z-index: 100; transform: translateY(-200%); }
  .skip-link:focus { transform: translateY(0); }
</style>
