---
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = true
---

<BaseLayout title="404 · 页面未找到">
  <Header slot="header" />
  <main id="main-content" class="page-shell not-found" slot="body">
    <h1>404</h1>
    <a class="button button-primary" href="/">回到首页 <span aria-hidden="true">→</span></a>
  </main>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
    justify-content: center;
    gap: 24px;
    padding-block: 80px;
  }
  @media (max-width: 639px) {
    .not-found {
      padding-block: 48px;
    }
    .not-found h1 {
      font-size: 32px;
    }
  }
</style>
