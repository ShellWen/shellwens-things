---
import { getCollection } from 'astro:content'
import Header from '@/components/Header.astro'
import Footer from '@/components/Footer.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostCard from '@/components/PostCard.astro'
import { sortCategoryBySortOrder, sortPostByPubDateDesc } from '@/lib/util/sorts'

export const prerender = true

const categories = (await getCollection('category')).sort(sortCategoryBySortOrder)
const posts = await getCollection('post')
---

<BaseLayout title="文章">
  <Header slot="header" />
  <main id="main-content" class="page-shell blog-index" slot="body" data-pagefind-body>
    <header class="blog-heading">
      <div>
        <h1 data-pagefind-meta="title">文章</h1>
      </div>
      <div class="blog-summary">
        <span>{posts.length} 篇文章</span>
        <a class="link" href="/rss.xml">RSS 订阅 <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <nav class="blog-categories" aria-label="文章分类">
      {categories.map((category) => (
        <a class="button button-quiet" href={`/blog/${category.id}/`}>{category.data.name}</a>
      ))}
    </nav>
    {categories
      .map((category) => ({
        category,
        posts: posts.filter((post) => post.data.category.id === category.id).sort(sortPostByPubDateDesc),
      }))
      .map(({ category, posts }) => (
        <section class="blog-category" aria-labelledby={`category-${category.id}`}>
          <header class="category-heading">
            <div>
              <h2 id={`category-${category.id}`} transition:name={`category-name-${category.id}`}>
                <a href={`/blog/${category.id}/`}>{category.data.name} <span aria-hidden="true">↗</span></a>
              </h2>
            </div>
            <a class="link category-feed" href={`/blog/${category.id}/rss.xml`} aria-label={`订阅${category.data.name} RSS`}>RSS</a>
          </header>
          {posts.length === 0 ? (
            <p class="category-empty">该分类暂无文章</p>
          ) : (
            <>
              <ul class="category-posts">
                {posts.slice(0, 7).map((post, index) => (
                  <li><PostCard {post} class:list={{ 'post-featured': index === 0 }} /></li>
                ))}
              </ul>
              {posts.length > 7 && (
                <div class="category-more">
                  <a class="button button-quiet" href={`/blog/${category.id}/`}>查看更多 <span aria-hidden="true">→</span></a>
                </div>
              )}
            </>
          )}
        </section>
      ))}
  </main>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .blog-index {
    padding-block: 48px 64px;
  }
  .blog-heading,
  .category-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
  }
  .blog-heading h1 {
    margin-block: 12px;
    font-size: clamp(28px, 3.5vw, 36px);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: -.01em;
  }
  .blog-summary {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
    color: var(--color-muted);
    font-size: 14px;
  }
  .blog-summary > a,
  .category-feed {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .blog-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-block: 24px 48px;
  }
  .blog-category + .blog-category {
    margin-top: 48px;
  }
  .category-heading {
    margin-bottom: 24px;
  }
  .category-heading h2 {
    font-size: 24px;
    line-height: 1.45;
  }
  .category-heading h2 a {
    display: inline-block;
    min-height: 44px;
    padding-block: 4px;
    text-decoration: none;
  }
  .category-heading h2 a:hover {
    color: var(--color-accent);
  }
  .category-heading h2 span {
    color: var(--color-accent);
    font-size: 18px;
  }
  .category-feed {
    flex-shrink: 0;
    font-size: 14px;
  }
  .category-posts > li + li {
    border-bottom: 1px solid var(--color-line);
  }
  .category-empty {
    border-radius: var(--radius-panel);
    padding: 24px;
    background: var(--color-soft);
    color: var(--color-muted);
  }
  .category-more {
    margin-top: 20px;
    text-align: end;
  }
  @media (max-width: 639px) {
    .blog-index {
      padding-block: 24px 40px;
    }
    .blog-heading {
      align-items: start;
      flex-direction: column;
      gap: 0;
    }
    .blog-heading h1 {
      margin-block: 0;
    }
    .blog-categories {
      gap: 4px 8px;
      margin-block: 16px 24px;
    }
    .blog-category + .blog-category {
      margin-top: 32px;
    }
    .category-heading {
      align-items: start;
      gap: 16px;
      margin-bottom: 16px;
    }
    .category-empty {
      padding: 20px;
    }
  }
</style>
